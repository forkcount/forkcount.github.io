rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Daily Food Diaries
    match /diaryEntries/{entryId} {
      allow read: if true;
      allow write: if true;
    }

    // Water Logs
    match /waterEntries/{entryId} {
      allow read: if true;
      allow write: if true;
    }

    // Exercise Logs
    match /exerciseEntries/{entryId} {
      allow read: if true;
      allow write: if true;
    }

    // Weight Records
    match /weightEntries/{entryId} {
      allow read: if true;
      allow write: if true;
    }

    // Nutrition / Meal Plans
    match /plans/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Habits, Cravings, Victories, Pantry, Saved Foods, Templates
    match /habits/{entryId} {
      allow read: if true;
      allow write: if true;
    }

    match /cravings/{entryId} {
      allow read: if true;
      allow write: if true;
    }

    match /victories/{entryId} {
      allow read: if true;
      allow write: if true;
    }

    match /pantry/{entryId} {
      allow read: if true;
      allow write: if true;
    }

    match /savedFoods/{entryId} {
      allow read: if true;
      allow write: if true;
    }

    match /savedRecipes/{entryId} {
      allow read: if true;
      allow write: if true;
    }

    match /mealTemplates/{entryId} {
      allow read: if true;
      allow write: if true;
    }

    match /communityPosts/{postId} {
      allow read: if true;
      allow write: if true;
    }

    match /communityReplies/{replyId} {
      allow read: if true;
      allow write: if true;
    }

    match /socialFriends/{friendId} {
      allow read: if true;
      allow write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
